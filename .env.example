# Admin Authentication Passcode for /admin and /interviews
ADMIN_PASSCODE=Suman@0216
VITE_ADMIN_PASSCODE=Suman@0216

# Google Calendar OAuth 2.0 Credentials
# Create your client ID & secret in Google Cloud Console -> APIs & Services -> Credentials
# Scope required: https://www.googleapis.com/auth/calendar.events.readonly
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# PostgreSQL + Prisma Database URL (Optional persistent store for calendar overrides)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_intelligence

# NVIDIA LLM & Audio Pipeline config
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_STT_MODEL=openai/whisper-large-v3
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MULTIMODAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TTS_MODEL=nvidia/magpie-multilingual

VITE_GITHUB_TOKEN=your_github_token
LLM_TIMEOUT_MS=6000
LLM_TTS_TIMEOUT_MS=6000

VITE_CHAT_API_URL=/api/chat
VITE_VOICE_API_URL=/api/voice
LOCAL_API_PORT=3001