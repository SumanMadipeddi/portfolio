# NVIDIA LLM & Audio Pipeline config
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_STT_MODEL=openai/whisper-large-v3
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MULTIMODAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TTS_MODEL=nvidia/magpie-multilingual

VITE_GITHUB_TOKEN=hqiwh
# Optional: timeout in ms for upstream model calls (default 6000ms, set to 0 to disable)
LLM_TIMEOUT_MS=6000
# Optional: separate timeout for TTS calls
LLM_TTS_TIMEOUT_MS=6000
# Set either timeout to 0 to disable abort timeout completely

# Optional: override frontend endpoints
VITE_CHAT_API_URL=/api/chat
VITE_VOICE_API_URL=/api/voice

# Optional: local dev API port for npm run dev
LOCAL_API_PORT=3001